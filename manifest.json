{
  "manifest_version": 3,
  "name": "Another Tab — Compare Ticket Prices & Find Sold-Out Alternatives",
  "version": "1.0.3",
  "description": "Compare ticket prices, find sold-out alternatives, and check available promo deals before checkout",
  "action": {
    "default_title": "Another Tab",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.ticketmaster.com/*",
    "https://www.stubhub.com/*",
    "https://www.vividseats.com/*",
    "https://seatgeek.com/*",
    "https://api.geturtix.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ticketmaster.com/*",
        "https://www.stubhub.com/*",
        "https://www.vividseats.com/*",
        "https://seatgeek.com/*"
      ],
      "js": ["vendor/browser-polyfill.min.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
